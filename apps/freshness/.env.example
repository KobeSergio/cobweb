# The freshness server's settings (docs/specs/2026-10-16-freshness-server.md, section 6.2). Copy to
# apps/freshness/.env for `pnpm --filter @cobweb/freshness dev`, which reads it when it exists.
# Never commit it. On Railway these are the service's variables.

# The port to listen on. Railway sets it; 3100 when unset.
PORT=

# production hides Sepolia, Robinhood Chain Testnet and Anvil.
NODE_ENV=
# 1 shows Sepolia, Robinhood Chain Testnet and Anvil where NODE_ENV=production hides them. A hosted test
# environment only.
COBWEB_TEST_CHAINS=

# The indexer's connection as the cobweb_indexer role, a secret: Supabase's session pooler string with the user
# cobweb_indexer.<project ref> and the role's password. Empty: the indexer is off. Local:
# postgresql://cobweb_indexer:<password>@127.0.0.1:55322/postgres, after setting the password with psql's
# `\password cobweb_indexer` (docker exec -it supabase_db_cobweb psql -U postgres), never a clear statement the
# server would log. Off this machine the connection is always TLS with the certificate and the host verified;
# sslmode, when given, must be verify-full.
INDEXER_DATABASE_URL=
# The database's CA certificate: its PEM text (a Railway variable carries it), or the path of its file. Supabase
# signs the session pooler's certificate and the database host's with its own root, not a public one (Database
# settings, SSL configuration, Download certificate: prod-ca-2021.crt), so every hosted connection needs it; a
# missing or wrong CA fails each pass with the TLS code. Empty: the system's CAs, which only a publicly signed
# server passes.
INDEXER_DATABASE_SSL_CA=

# Per chain: the server reads a chain when both of its variables are set. RPC_URL_<id> is a secret (the URL
# carries the provider's key) and never leaves the server; FACTORY_ADDRESS_<id> is the Cobweb factory there.
# For a local chain run `pnpm --filter @cobweb/web chain:local` and copy the two lines it prints.
# Ethereum
RPC_URL_1=
FACTORY_ADDRESS_1=
# Arbitrum
RPC_URL_42161=
FACTORY_ADDRESS_42161=
# Base
RPC_URL_8453=
FACTORY_ADDRESS_8453=
# Berachain
RPC_URL_80094=
FACTORY_ADDRESS_80094=
# Monad
RPC_URL_143=
FACTORY_ADDRESS_143=
# Robinhood Chain
RPC_URL_4663=
FACTORY_ADDRESS_4663=
# Sepolia (a test chain)
RPC_URL_11155111=
FACTORY_ADDRESS_11155111=
# Robinhood Chain Testnet (a test chain)
RPC_URL_46630=
FACTORY_ADDRESS_46630=
# Anvil (a test chain)
RPC_URL_31337=
FACTORY_ADDRESS_31337=
