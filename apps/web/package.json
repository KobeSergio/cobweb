{
  "name": "@cobweb/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "verify:local": "node scripts/verify-local.ts",
    "verify:storage": "node --conditions=react-server scripts/verify-storage.ts",
    "chain:local": "node scripts/chain-local.ts",
    "verify:chain": "node --conditions=react-server --import ./scripts/resolve-ts.mjs scripts/verify-chain.ts",
    "sweep:uploads": "node --conditions=react-server scripts/sweep-uploads.ts",
    "verify:sweep": "node --conditions=react-server --import ./scripts/resolve-ts.mjs scripts/verify-sweep.ts",
    "verify:render": "node --conditions=react-server --import ./scripts/resolve-ts.mjs scripts/verify-render.ts",
    "render:local": "node --conditions=react-server --import ./scripts/resolve-ts.mjs scripts/render-local.ts",
    "verify:deploy": "node --conditions=react-server --import ./scripts/resolve-ts.mjs scripts/verify-deploy.ts",
    "verify:phases": "node --conditions=react-server --import ./scripts/resolve-ts.mjs scripts/verify-phases.ts",
    "verify:whitelist": "node --conditions=react-server --import ./scripts/resolve-ts.mjs scripts/verify-whitelist.ts",
    "verify:airdrop": "node --conditions=react-server --import ./scripts/resolve-ts.mjs scripts/verify-airdrop.ts",
    "verify:settings": "node --conditions=react-server --import ./scripts/resolve-ts.mjs scripts/verify-settings.ts",
    "verify:freshness": "node --conditions=react-server --import ./scripts/resolve-ts.mjs scripts/verify-freshness.ts",
    "verify:mint-page": "node --conditions=react-server --import ./scripts/resolve-ts.mjs scripts/verify-mint-page.ts",
    "verify:indexer": "node --conditions=react-server --import ./scripts/resolve-ts.mjs scripts/verify-indexer.ts",
    "verify:csp": "node --conditions=react-server --import ./scripts/resolve-ts.mjs scripts/verify-csp.ts",
    "verify:sources": "node --conditions=react-server --import ./scripts/resolve-ts.mjs scripts/verify-sources.ts",
    "verify:load": "node --conditions=react-server --import ./scripts/resolve-ts.mjs scripts/verify-load.ts"
  },
  "devDependencies": {
    "@cobweb/freshness": "workspace:^",
    "@ipld/car": "5.4.7",
    "@ipld/unixfs": "3.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wagmi/core": "2.22.1",
    "multiformats": "14.0.5",
    "postgres": "3.4.9",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@cobweb/dna": "workspace:^",
    "@cobweb/render": "workspace:^",
    "@cobweb/shared": "workspace:^",
    "@cobweb/ui": "workspace:^",
    "@cobweb/worker": "workspace:^",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "@vercel/queue": "0.8.0",
    "lucide-react": "^1.50.0",
    "motion": "^14.0.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
