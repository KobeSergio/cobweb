# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project. For local development run `supabase start` at the repo root and copy the
# API URL and publishable key from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# WalletConnect project id, from https://cloud.reown.com. Browser-extension wallets work without
# it; WalletConnect QR and mobile wallets do not.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Sample-data mode. 1 opens every stage of the collection workspace and fills the screens with the
# Night Owls sample from src/lib/demo, with a "Sample data" chip in the top bar. Keep 0 in production.
NEXT_PUBLIC_DEMO_DATA=0

# Object storage for layer images, assets and placeholders (server only; never NEXT_PUBLIC_).
# Local: run `supabase status -o env` and copy STORAGE_S3_URL, S3_PROTOCOL_REGION,
# S3_PROTOCOL_ACCESS_KEY_ID and S3_PROTOCOL_ACCESS_KEY_SECRET; the bucket is "art" and path style is on.
# Production: leave ART_S3_ENDPOINT unset for AWS, set the bucket's region and an IAM key scoped to it.
# Production, AWS: the bucket needs a CORS rule allowing PUT with the Content-Type header from the app
# origin. AWS has no bucket-side size or type limit; the signed length and the server's HEAD check are
# the guard. Leave ART_S3_FORCE_PATH_STYLE unset on AWS.
ART_S3_ENDPOINT=
ART_S3_REGION=
ART_S3_BUCKET=art
ART_S3_ACCESS_KEY_ID=
ART_S3_SECRET_ACCESS_KEY=
ART_S3_FORCE_PATH_STYLE=1
