# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project. For local development run `supabase start` at the repo root and copy the
# API URL and publishable key from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role key, SERVER ONLY: never prefix it NEXT_PUBLIC_ and never import lib/supabase/service.ts
# from client code. Used only to record the lock, the requote and the verified payment. Local: the
# SERVICE_ROLE_KEY (or SECRET_KEY) from `supabase status -o env`.
SUPABASE_SERVICE_ROLE_KEY=

# WalletConnect project id, from https://cloud.reown.com. Browser-extension wallets work without
# it; WalletConnect QR and mobile wallets do not.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# The freshness server's origin, public: the mint page polls it from the browser. Local: http://127.0.0.1:3100
# with `pnpm --filter @cobweb/freshness dev`. Read at build time; rebuild after changing it.
NEXT_PUBLIC_FRESHNESS_URL=

# Sample-data mode. 1 opens every stage of the collection workspace and fills the screens with the
# Night Owls sample from src/lib/demo, with a "Sample data" chip in the top bar. Keep 0 in production.
NEXT_PUBLIC_DEMO_DATA=0

# Object storage for layer images, assets and placeholders (server only; never NEXT_PUBLIC_).
# Local: run `supabase status -o env` and copy STORAGE_S3_URL, S3_PROTOCOL_REGION,
# S3_PROTOCOL_ACCESS_KEY_ID and S3_PROTOCOL_ACCESS_KEY_SECRET; the bucket is "art" and path style is on.
# Production: Cloudflare R2. ART_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com,
# ART_S3_REGION=auto, path style on, and an R2 API token with object read and write on the art and
# render buckets. The art bucket needs a CORS rule allowing PUT with the Content-Type header from the
# app origin (services/worker/README.md has the rule). The signed length and the server's HEAD check
# are the size guard.
ART_S3_ENDPOINT=
ART_S3_REGION=
ART_S3_BUCKET=art
ART_S3_ACCESS_KEY_ID=
ART_S3_SECRET_ACCESS_KEY=
ART_S3_FORCE_PATH_STYLE=1

# Chains for the art fee (server only; never NEXT_PUBLIC_). A chain is ready for payments when both
# RPC_URL_<chain id> and FACTORY_ADDRESS_<chain id> are set. For local development run
# `pnpm --filter @cobweb/web chain:local` and copy the two lines it prints.
RPC_URL_31337=
FACTORY_ADDRESS_31337=

# 1 shows Sepolia, Robinhood Chain Testnet and Anvil where NODE_ENV=production hides them. A hosted test
# environment only. The web app reads it at build time, so set it where the build runs and rebuild after
# changing it.
COBWEB_TEST_CHAINS=

# The mint page's media (server only; never NEXT_PUBLIC_): the public bucket the Mint page tab uploads the
# banner, avatar, About banner, team photos, slides and music to, behind the art bucket's endpoint and keys.
# Local: the "mint-page" bucket in Supabase Storage, created by `supabase seed buckets`. Production: a public R2
# bucket on a custom domain, with the art bucket's CORS rule for PUT from the app origin.
MINT_PAGE_S3_BUCKET=mint-page
# The bucket's public base, which the page links its files from. Empty: Supabase Storage's public URL for it
# (<NEXT_PUBLIC_SUPABASE_URL>/storage/v1/object/public/<bucket>). Production: the R2 bucket's custom domain.
MINT_PAGE_MEDIA_URL=

# The IPFS gateway the mint page reads token metadata and art through (server only; the page receives it with
# its content). A public gateway with no key in the URL. Empty: https://ipfs.io/ipfs.
IPFS_GATEWAY_URL=

# The render bucket (server only; never NEXT_PUBLIC_): the preview collages the render worker writes.
# Local: the "render" bucket in Supabase Storage, created by `supabase seed buckets`. Production: the
# second R2 bucket, behind the same endpoint and token as the art bucket. It must not be the art
# bucket. verify:render uses "render" unless set in the shell environment.
RENDER_S3_BUCKET=render

# The render worker's pinning service (server only; never NEXT_PUBLIC_): a Filebase IPFS bucket and its
# access key pair. The endpoint defaults to https://s3.filebase.com. Not used locally: verify:render
# pins to a folder. The worker's own notes are in services/worker/README.md.
FILEBASE_S3_ENDPOINT=
FILEBASE_BUCKET=
FILEBASE_ACCESS_KEY_ID=
FILEBASE_SECRET_ACCESS_KEY=

# The secret Vercel sends with each cron request as `Authorization: Bearer <CRON_SECRET>`; the render
# sweep route answers 404 without it. Generate one with `openssl rand -hex 32`. Not used locally.
CRON_SECRET=
