# Copy to .env and fill in. Never commit .env.

# Account that sends the deployment transactions
DEPLOYER_PRIVATE_KEY=

# Platform admin (sets fees, approves collection code) and where fees are paid out.
# Use the same two addresses on every chain so the factory lands on the same address.
FACTORY_ADMIN=
FACTORY_TREASURY=

# RPC endpoint and explorer API key for the chain being deployed to
RPC_URL=
ETHERSCAN_API_KEY=
